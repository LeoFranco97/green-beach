# Copie este arquivo para .env e ajuste o que for preciso.
# Toda variavel lida pelo Vite precisa do prefixo VITE_.

# WhatsApp oficial, formato E.164 sem espaco nem sinal: 55 + DDD + numero.
# Este e o numero que a propria pousada divulga como canal de reserva.
VITE_WHATSAPP_NUMBER=5547997948332

# Dominio final do site, sem barra no fim. PENDENTE de registro.
VITE_SITE_URL=https://www.pousadagreenbeach.com.br

# Google Analytics 4. Deixe vazio para nao carregar o GA.
VITE_GA_MEASUREMENT_ID=

# Pixel da Meta. Deixe vazio para nao carregar.
VITE_META_PIXEL_ID=

# Endereco usado no mapa e no link de rota.
VITE_MAP_QUERY=Pousada e Hotel Green Beach, Rua 141, 58, Centro, Itapema, SC, 88220-000
VITE_MAP_PLACE_ID=ChIJCbzvCqOx2JQRMgYOV9J4-ys
